<c:LiquidGlassWindow x:Class="KittyDy0Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:KittyDy0Launcher.Controls"
        Title="KittyDy0 Launcher" Icon="Assets/icon.png" Width="1100" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource TextBrush}">

    <Border CornerRadius="20" Background="{DynamicResource WindowBg}"
            BorderBrush="#33FFE57F" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <!--
              BackdropArt: lớp nền dưới cùng. Các thấu kính kính-lỏng (GlassLens) lấy ảnh ở đây rồi khúc xạ ở vành kính.
              Gồm nền, hai quầng sáng thương hiệu, các đốm sáng (bokeh), vài vệt sáng thẳng và ảnh nền tuỳ chọn.
            -->
            <Grid x:Name="BackdropArt" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Fill="{DynamicResource WindowBg}"/>
                <Image x:Name="ArtImage" Source="{Binding BackgroundImage}" Stretch="UniformToFill" Opacity="0.85"
                       Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVis}}"/>
                <!-- Làm tối nhẹ ảnh nền để chữ trên thẻ luôn dễ đọc, kể cả với ảnh sáng -->
                <Rectangle Fill="#120A0D" IsHitTestVisible="False" Opacity="{DynamicResource BackdropDim}"
                           Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVis}}"/>
                <Rectangle IsHitTestVisible="False" Visibility="{DynamicResource LgLayerVisibility}">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.8,0.1" GradientOrigin="0.8,0.1" RadiusX="0.6" RadiusY="0.5">
                            <GradientStop Color="#38E63946" Offset="0"/>
                            <GradientStop Color="#00E63946" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False" Visibility="{DynamicResource LgLayerVisibility}">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.1,0.9" GradientOrigin="0.1,0.9" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#1FFFB703" Offset="0"/>
                            <GradientStop Color="#00FFB703" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Đốm sáng và vệt sáng mặc định chỉ hiện khi KHÔNG có ảnh nền riêng -->
                <Grid Visibility="{Binding ShowDefaultArt, Converter={StaticResource BoolToVis}}">
                <Canvas Width="1100" Height="680" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{DynamicResource LgLayerVisibility}">
                    <Ellipse Canvas.Left="893" Canvas.Top="402" Width="220" Height="220">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#662DD4BF" Offset="0"/>
                                <GradientStop Color="#662DD4BF" Offset="0.62"/>
                                <GradientStop Color="#002DD4BF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="318" Canvas.Top="464" Width="130" Height="130">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#667A5CFF" Offset="0"/>
                                <GradientStop Color="#667A5CFF" Offset="0.62"/>
                                <GradientStop Color="#007A5CFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="321" Canvas.Top="36" Width="280" Height="280">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#557A5CFF" Offset="0"/>
                                <GradientStop Color="#557A5CFF" Offset="0.62"/>
                                <GradientStop Color="#007A5CFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="125" Canvas.Top="491" Width="130" Height="130">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#66FFE57F" Offset="0"/>
                                <GradientStop Color="#66FFE57F" Offset="0.62"/>
                                <GradientStop Color="#00FFE57F" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="751" Canvas.Top="403" Width="90" Height="90">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#66FFE57F" Offset="0"/>
                                <GradientStop Color="#66FFE57F" Offset="0.62"/>
                                <GradientStop Color="#00FFE57F" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="262" Canvas.Top="578" Width="280" Height="280">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#66E63946" Offset="0"/>
                                <GradientStop Color="#66E63946" Offset="0.62"/>
                                <GradientStop Color="#00E63946" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="61" Canvas.Top="-24" Width="90" Height="90">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4AFFB703" Offset="0"/>
                                <GradientStop Color="#4AFFB703" Offset="0.62"/>
                                <GradientStop Color="#00FFB703" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="1" Canvas.Top="415" Width="280" Height="280">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#55FF5FA8" Offset="0"/>
                                <GradientStop Color="#55FF5FA8" Offset="0.62"/>
                                <GradientStop Color="#00FF5FA8" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="340" Canvas.Top="471" Width="280" Height="280">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#66FFB703" Offset="0"/>
                                <GradientStop Color="#66FFB703" Offset="0.62"/>
                                <GradientStop Color="#00FFB703" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="963" Canvas.Top="-56" Width="170" Height="170">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4AFFE57F" Offset="0"/>
                                <GradientStop Color="#4AFFE57F" Offset="0.62"/>
                                <GradientStop Color="#00FFE57F" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="509" Canvas.Top="356" Width="220" Height="220">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4A2DD4BF" Offset="0"/>
                                <GradientStop Color="#4A2DD4BF" Offset="0.62"/>
                                <GradientStop Color="#002DD4BF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="460" Canvas.Top="262" Width="340" Height="340">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#66FFB703" Offset="0"/>
                                <GradientStop Color="#66FFB703" Offset="0.62"/>
                                <GradientStop Color="#00FFB703" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="0" Canvas.Top="11" Width="170" Height="170">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4A2DD4BF" Offset="0"/>
                                <GradientStop Color="#4A2DD4BF" Offset="0.62"/>
                                <GradientStop Color="#002DD4BF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="160" Canvas.Top="237" Width="220" Height="220">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4A7A5CFF" Offset="0"/>
                                <GradientStop Color="#4A7A5CFF" Offset="0.62"/>
                                <GradientStop Color="#007A5CFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="-59" Canvas.Top="158" Width="90" Height="90">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4AFFB703" Offset="0"/>
                                <GradientStop Color="#4AFFB703" Offset="0.62"/>
                                <GradientStop Color="#00FFB703" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="708" Canvas.Top="346" Width="220" Height="220">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4A7A5CFF" Offset="0"/>
                                <GradientStop Color="#4A7A5CFF" Offset="0.62"/>
                                <GradientStop Color="#007A5CFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Rectangle Canvas.Left="120" Canvas.Top="90" Width="700" Height="3" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform><RotateTransform Angle="-18"/></Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#66FFE9C4" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Canvas.Left="420" Canvas.Top="430" Width="760" Height="3" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform><RotateTransform Angle="14"/></Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#66FFE9C4" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Canvas.Left="-40" Canvas.Top="300" Width="600" Height="3" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform><RotateTransform Angle="8"/></Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#66FFE9C4" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Canvas>
                </Grid>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Chỗ đặt thanh menu khi chọn Trái / Phải / Dưới (Trên: nằm trong thanh tiêu đề) -->
                <Border x:Name="NavSlotLeft" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="16,12,0,28"/>
                <Border x:Name="NavSlotRight" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,12,16,28"/>
                <Border x:Name="NavSlotBottom" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- ===== Thanh tiêu đề + menu ===== -->
                <Grid x:Name="TitleBarGrid" Grid.Row="0" Grid.ColumnSpan="3" Margin="16,12,16,0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/icon.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="KittyDy0 Launcher" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold" FontSize="17"/>
                    </StackPanel>

                    <!-- Menu dạng pill với thanh vàng trượt -->
                    <c:LiquidGlassNavigation x:Name="NavBar" Grid.Column="1" HorizontalAlignment="Center" Padding="4">
                        <Grid x:Name="NavHost">
                            <!-- Giọt kính vàng: tán sắc ở mép, kéo dãn như chất lỏng khi chuyển mục -->
                            <Border x:Name="NavIndicator" Width="0" Opacity="0" CornerRadius="18"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    RenderTransformOrigin="0.5,0.5" Effect="{DynamicResource LgPrimaryGlow}">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="NavScale"/>
                                        <TranslateTransform x:Name="NavMove"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Grid>
                                    <c:GlassSurface CornerRadius="18" HasShadow="False" HasDispersion="True"/>
                                    <Border CornerRadius="18" IsHitTestVisible="False" Background="{DynamicResource LgBubbleTint}"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="NavItems" Orientation="Horizontal">
                                <RadioButton x:Name="NavHome" Content="Trang chủ" Tag="home" GroupName="nav"
                                             IsChecked="True" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavInstances" Content="Instance" Tag="instances" GroupName="nav"
                                             Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                                <RadioButton Content="Tài khoản" Tag="accounts" GroupName="nav"
                                             Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                                <RadioButton Content="Tải về" Tag="mods" GroupName="nav"
                                             Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                                <RadioButton Content="Nhật ký" Tag="log" GroupName="nav"
                                             Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                                <RadioButton Content="Tin tức" Tag="news" GroupName="nav"
                                             Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                                <RadioButton Content="Cài đặt" Tag="settings" GroupName="nav"
                                             Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                            </StackPanel>
                        </Grid>
                    </c:LiquidGlassNavigation>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource OnlineBrush}"
                                 Effect="{StaticResource OnlineGlow}" VerticalAlignment="Center"/>
                        <TextBlock Text="kittydy0.online" Margin="8,0,0,0" FontSize="13"
                                   Foreground="{StaticResource SunBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="—" Style="{StaticResource IconButton}" Click="Minimize_Click"/>
                    <Button Grid.Column="4" Content="✕" Style="{StaticResource IconButton}" Click="Close_Click"/>
                </Grid>

                <!-- ===== Nội dung các trang ===== -->
                <Grid Grid.Row="1" Grid.Column="1" Margin="36,12,36,28">

                    <!-- ========== Trang chủ ========== -->
                    <Grid x:Name="PageHome">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <Border HorizontalAlignment="Left" CornerRadius="12" Padding="12,3" Background="#1FFFFFFF">
                                <TextBlock Text="SUPER HARD SMP" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SunBrush}"/>
                            </Border>
                            <TextBlock Margin="0,14,0,0" FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold"
                                       FontSize="76" LineHeight="76" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{StaticResource TitleGradient}" Effect="{StaticResource TitleGlow}">
                                <Run Text="KittyDy0"/><LineBreak/><Run Text="Launcher"/>
                            </TextBlock>
                            <TextBlock Margin="0,18,0,26" MaxWidth="440" HorizontalAlignment="Left" TextWrapping="Wrap"
                                       FontSize="16" Foreground="{StaticResource MutedBrush}"
                                       Text="Launcher chính thức của máy chủ Minecraft KittyDy0. Chọn instance, nhập tên và vào game chỉ với một cú nhấp."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Sao chép IP: kittydy0.online" Style="{StaticResource PillButton}"
                                        Click="CopyIp_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Thẻ vào game -->
                        <ContentControl Grid.Column="1" Style="{StaticResource GlassCard}" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Vào game" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="ExtraBold" FontSize="22"/>

                                <TextBlock Text="Tài khoản" Style="{StaticResource Label}"/>
                                <ComboBox Style="{StaticResource PillComboBox}"
                                          ItemsSource="{Binding AuthModeLabels}"
                                          SelectedItem="{Binding AuthLabel, Mode=TwoWay}"/>
                                <TextBox Margin="0,10,0,0" Style="{StaticResource PillTextBox}" MaxLength="16"
                                         Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsOfflineMode, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Margin="6,8,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource SunBrush}"
                                           Text="{Binding HomeAccountText}"
                                           Visibility="{Binding IsOnlineMode, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="Instance" Style="{StaticResource Label}"/>
                                <ComboBox Style="{StaticResource PillComboBox}"
                                          ItemsSource="{Binding Instances}"
                                          SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding VersionId}" Margin="10,0,0,0"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Mở thư mục" Style="{StaticResource PillButton}" Padding="16,6"
                                            FontSize="12" Command="{Binding OpenInstanceFolderCommand}"/>
                                    <Button Content="mods" Margin="6,0,0,0" Style="{StaticResource PillButton}" Padding="14,6"
                                            FontSize="12" Command="{Binding OpenInstanceSubFolderCommand}" CommandParameter="mods"/>
                                    <Button Content="resourcepacks" Margin="6,0,0,0" Style="{StaticResource PillButton}"
                                            Padding="14,6" FontSize="12"
                                            Command="{Binding OpenInstanceSubFolderCommand}" CommandParameter="resourcepacks"/>
                                </StackPanel>

                                <Button Content="CHƠI" Margin="0,22,0,0" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding PlayCommand}"/>
                                <Button Content="Dừng / Hủy" Margin="0,10,0,0" Style="{StaticResource PillButton}"
                                        Padding="22,9" FontSize="13" Command="{Binding StopCommand}"/>

                                <ProgressBar Margin="0,18,0,0" Style="{StaticResource GoldProgress}"
                                             Value="{Binding Progress}"/>
                                <TextBlock Margin="4,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding StatusText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ContentControl>
                    </Grid>

                    <!-- ========== Instance ========== -->
                    <Grid x:Name="PageInstances" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Danh sách -->
                        <ContentControl Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,16,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Instance" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="ExtraBold" FontSize="22"/>
                                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,12,0,12">
                                    <Button Content="+ Mới" Style="{StaticResource PillButton}" Padding="8,8" FontSize="13"
                                            Margin="0,0,6,0" Command="{Binding NewInstanceCommand}"/>
                                    <Button Content="Nhân bản" Style="{StaticResource PillButton}" Padding="8,8" FontSize="13"
                                            Margin="0,0,6,0" Command="{Binding DuplicateInstanceCommand}"/>
                                    <Button Content="Xóa" Style="{StaticResource PillButton}" Padding="8,8" FontSize="13"
                                            Command="{Binding DeleteInstanceCommand}"/>
                                </UniformGrid>
                                <Button DockPanel.Dock="Top" Content="Nhập modpack (.mrpack / .zip)"
                                        Style="{StaticResource PillButton}" Padding="8,8" FontSize="13"
                                        Margin="0,0,0,12" Command="{Binding ImportModpackCommand}"/>
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Instances}"
                                         SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding VersionId}" FontSize="12"
                                                               Foreground="{StaticResource SunBrush}"/>
                                                    <TextBlock Text="{Binding InstalledText, StringFormat=' · {0}'}" FontSize="12"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding LoaderBadge}" FontSize="12"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </ContentControl>

                        <!-- Trình chỉnh sửa -->
                        <ContentControl Grid.Column="1" Style="{StaticResource GlassCard}" Padding="22,18,12,18">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasInstance, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Cài đặt instance (tự động lưu)" FontFamily="{StaticResource HeadFont}"
                                                   FontWeight="ExtraBold" FontSize="22"/>

                                        <TextBlock Text="Tên instance" Style="{StaticResource Label}"/>
                                        <TextBox Style="{StaticResource PillTextBox}"
                                                 Text="{Binding SelectedInstance.Name, UpdateSourceTrigger=PropertyChanged}"/>

                                        <Grid Margin="0,14,0,6">
                                            <TextBlock Text="Phiên bản Minecraft (mới nhất → cổ nhất)"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding VersionInfo}" HorizontalAlignment="Right" FontSize="12"
                                                       Foreground="{StaticResource SunBrush}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ToggleButton Content="Release" Style="{StaticResource ChipToggle}"
                                                          IsChecked="{Binding ShowRelease, Mode=TwoWay}"/>
                                            <ToggleButton Content="Snapshot" Style="{StaticResource ChipToggle}"
                                                          IsChecked="{Binding ShowSnapshot, Mode=TwoWay}"/>
                                            <ToggleButton Content="Beta" Style="{StaticResource ChipToggle}"
                                                          IsChecked="{Binding ShowBeta, Mode=TwoWay}"/>
                                            <ToggleButton Content="Alpha" Style="{StaticResource ChipToggle}"
                                                          IsChecked="{Binding ShowAlpha, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <ComboBox Style="{StaticResource PillComboBox}" ItemsSource="{Binding Versions}"
                                                  SelectedItem="{Binding EditVersion, Mode=TwoWay}"/>
                                        <TextBlock Margin="4,8,0,0" FontSize="12" Foreground="{StaticResource SunBrush}"
                                                   Text="{Binding SelectedInstance.LoaderLabel}"
                                                   Visibility="{Binding SelectedInstance.HasLoader, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Mod loader: chọn loại, chọn phiên bản, tải và cài -->
                                        <TextBlock Text="Mod loader" Style="{StaticResource Label}"/>
                                        <ComboBox Style="{StaticResource PillComboBox}" ItemsSource="{Binding LoaderTypeLabels}"
                                                  SelectedItem="{Binding LoaderTypeLabel, Mode=TwoWay}"/>

                                        <StackPanel Visibility="{Binding IsLoaderChosen, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Phiên bản loader" Style="{StaticResource Label}"/>
                                            <ComboBox Style="{StaticResource PillComboBox}" ItemsSource="{Binding LoaderVersionList}"
                                                      SelectedItem="{Binding LoaderVersionChoice, Mode=TwoWay}"/>
                                            <TextBlock Margin="4,6,0,0" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding LoaderListStatus}"/>
                                            <Button Content="Tải &amp; cài mod loader" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                    Style="{StaticResource PillButton}" Padding="20,10" FontSize="13"
                                                    Command="{Binding InstallLoaderCommand}"/>
                                        </StackPanel>

                                        <Button Content="Gỡ mod loader khỏi instance này" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource PillButton}" Padding="20,10" FontSize="13"
                                                Command="{Binding RemoveLoaderCommand}"
                                                Visibility="{Binding SelectedInstance.HasLoader, Converter={StaticResource BoolToVis}}"/>

                                        <Grid Margin="0,14,0,6">
                                            <TextBlock Text="RAM" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding SelectedInstance.RamGb, StringFormat='{}{0} GB'}"
                                                       HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SunBrush}"/>
                                        </Grid>
                                        <Slider Style="{StaticResource GoldSlider}" Minimum="2" Maximum="16"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding SelectedInstance.RamGb, Mode=TwoWay}"/>

                                        <TextBlock Text="Nguồn Java" Style="{StaticResource Label}"/>
                                        <ComboBox Style="{StaticResource PillComboBox}" ItemsSource="{Binding InstanceJavaLabels}"
                                                  SelectedItem="{Binding SelectedInstance.JavaSourceLabel, Mode=TwoWay}"/>

                                        <Grid Margin="0,10,0,0"
                                              Visibility="{Binding SelectedInstance.IsCustomJava, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource PillTextBox}"
                                                     Text="{Binding SelectedInstance.JavaPath, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="Chọn..." Margin="8,0,0,0"
                                                    Style="{StaticResource PillButton}" Padding="18,10" FontSize="13"
                                                    Command="{Binding BrowseJavaCommand}"/>
                                        </Grid>

                                        <TextBlock Text="Tham số JVM thêm (không bắt buộc)" Style="{StaticResource Label}"/>
                                        <TextBox Style="{StaticResource PillTextBox}"
                                                 Text="{Binding SelectedInstance.JvmArgs, UpdateSourceTrigger=PropertyChanged}"/>

                                        <CheckBox Style="{StaticResource GoldCheck}" Margin="4,18,0,0"
                                                  Content="Tự vào server kittydy0.online khi mở game"
                                                  IsChecked="{Binding SelectedInstance.AutoJoin, Mode=TwoWay}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,4">
                                            <Button Content="Mở thư mục instance" Style="{StaticResource PillButton}"
                                                    Padding="18,10" FontSize="13" Command="{Binding OpenInstanceFolderCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <TextBlock Text="Chưa có instance nào. Bấm &quot;+ Mới&quot; để tạo."
                                           Foreground="{StaticResource MutedBrush}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding NoInstance, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </ContentControl>
                    </Grid>

                    <!-- ========== Tải về: Mods / Resource Pack / Modpack (Modrinth, CurseForge) ========== -->
                    <Grid x:Name="PageMods" Visibility="Collapsed">
                        <Grid.Resources>
                            <!-- Ảnh đại diện: có ảnh thì hiện ảnh, thiếu ảnh hoặc tải lỗi thì hiện ô chữ cái màu (luôn đồng đều) -->
                            <DataTemplate x:Key="ModIconTemplate">
                                <Grid Width="56" Height="56">
                                    <Border CornerRadius="14" Background="{Binding PlaceholderBrush}"
                                            Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Initial}" FontSize="24" FontWeight="ExtraBold"
                                                   Foreground="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="14" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </Grid.Resources>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Chọn loại, nguồn, instance và ô tìm kiếm -->
                            <ContentControl Grid.Row="0" Style="{StaticResource GlassCard}" Padding="20,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Mods" GroupName="modcat" Style="{StaticResource SegmentRadio}"
                                                     IsChecked="{Binding IsCatMods, Mode=TwoWay}"/>
                                        <RadioButton Content="Resource Pack" Margin="8,0,0,0" GroupName="modcat"
                                                     Style="{StaticResource SegmentRadio}"
                                                     IsChecked="{Binding IsCatResourcePack, Mode=TwoWay}"/>
                                        <RadioButton Content="Modpack" Margin="8,0,0,0" GroupName="modcat"
                                                     Style="{StaticResource SegmentRadio}"
                                                     IsChecked="{Binding IsCatModpack, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Visibility="{Binding NeedsInstance, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Cài vào instance" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                            <ComboBox Margin="0,4,12,0" Style="{StaticResource PillComboBox}"
                                                      ItemsSource="{Binding Instances}" DisplayMemberPath="Name"
                                                      SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Width="170">
                                            <TextBlock Text="Nguồn" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                            <ComboBox Margin="0,4,0,0" Style="{StaticResource PillComboBox}"
                                                      ItemsSource="{Binding ModSources}"
                                                      SelectedItem="{Binding ModSource, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="6,8,0,0" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{StaticResource SunBrush}" Text="{Binding ModTargetText}"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Width="220">
                                            <TextBlock Text="Phiên bản Minecraft (vd 1.12.2)" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBox Margin="0,4,0,0" Style="{StaticResource PillTextBox}" MaxLength="12" Height="38"
                                                     FontSize="13" Text="{Binding ModMcVersion, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding SearchModsCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Right"
                                                    Visibility="{Binding NeedsInstance, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Bỏ trống = theo instance đang chọn" FontSize="12" VerticalAlignment="Center"
                                                       Margin="0,0,14,6" Foreground="{StaticResource MutedBrush}"/>
                                            <Button Content="Mở thư mục mods" Style="{StaticResource PillButton}" Padding="14,6" FontSize="12"
                                                    Command="{Binding OpenInstanceSubFolderCommand}" CommandParameter="mods"/>
                                            <Button Content="resourcepacks" Margin="6,0,0,0" Style="{StaticResource PillButton}"
                                                    Padding="14,6" FontSize="12"
                                                    Command="{Binding OpenInstanceSubFolderCommand}" CommandParameter="resourcepacks"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource PillTextBox}"
                                                 Text="{Binding ModQuery, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding SearchModsCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="Tìm" Margin="10,0,0,0" Padding="26,10" FontSize="14"
                                                Style="{StaticResource PillButton}" Command="{Binding SearchModsCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>

                            <!-- Kết quả: mỗi thẻ có nút Tải về và nút Chi tiết -->
                            <ContentControl Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,14,0,0" Padding="14,10">
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding ModResults}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModIconTemplate}"
                                                                VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,2,0,0"
                                                               Foreground="{StaticResource SunBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,4,0,0"
                                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                               MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding InfoLine}" FontSize="11.5" Margin="0,5,0,0"
                                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Warning, StringFormat='⚠ {0}'}" FontSize="12"
                                                               Margin="0,5,0,0" Foreground="#FF9F43" TextWrapping="Wrap"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="118">
                                                    <Button Content="{Binding ActionText}" Style="{StaticResource PillButton}"
                                                            Padding="14,8" FontSize="13" Foreground="{StaticResource SunBrush}"
                                                            Command="{Binding DataContext.InstallModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Chi tiết" Margin="0,8,0,0" Style="{StaticResource PillButton}"
                                                            Padding="14,8" FontSize="13"
                                                            Command="{Binding DataContext.ShowModDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ContentControl>

                            <!-- Phân trang -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button Content="←  Trước" Style="{StaticResource PillButton}" Padding="20,8" FontSize="13"
                                        Command="{Binding PrevModPageCommand}" IsEnabled="{Binding HasPrevModPage}"/>
                                <TextBlock Text="{Binding ModPageText}" VerticalAlignment="Center" Margin="18,0"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <Button Content="Sau  →" Style="{StaticResource PillButton}" Padding="20,8" FontSize="13"
                                        Command="{Binding NextModPageCommand}" IsEnabled="{Binding HasNextModPage}"/>
                            </StackPanel>

                            <!-- Trạng thái + tiến trình -->
                            <StackPanel Grid.Row="3" Margin="6,10,0,0">
                                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SunBrush}"
                                           Text="{Binding ModStatus}"/>
                                <ProgressBar Margin="0,8,0,0" Style="{StaticResource GoldProgress}" Value="{Binding Progress}"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Cửa sổ chi tiết: phiên bản, ngày cập nhật, hỗ trợ, thông tin cập nhật... -->
                        <Grid x:Name="ModDetailOverlay" Background="#B3000000"
                              Visibility="{Binding IsModDetailOpen, Converter={StaticResource BoolToVis}}"
                              MouseLeftButtonDown="ModDetailBackdrop_MouseDown">
                            <ContentControl Style="{StaticResource GlassCard}" MaxWidth="700" MaxHeight="500" Margin="30"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding ModDetailHit}" ContentTemplate="{StaticResource ModIconTemplate}"/>
                                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModDetailHit.Title}" FontFamily="{StaticResource HeadFont}"
                                                       FontWeight="ExtraBold" FontSize="20" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ModDetailHit.Subtitle}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{StaticResource SunBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Đóng" Style="{StaticResource PillButton}" Padding="18,8"
                                                FontSize="13" VerticalAlignment="Top" Command="{Binding CloseModDetailCommand}"/>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Đang tải chi tiết..." FontSize="13" Foreground="{StaticResource MutedBrush}"
                                                       Visibility="{Binding IsModDetailLoading, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding ModDetail.Error}" FontSize="13" Foreground="#FF9F43" TextWrapping="Wrap"
                                                       Visibility="{Binding ModDetail.HasError, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding ModDetail.Description}" FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedBrush}"/>

                                            <!-- Chọn đúng phiên bản muốn cài (ví dụ bản cho Minecraft 1.12.2) -->
                                            <TextBlock Text="Đang tải danh sách phiên bản..." FontSize="12" Margin="0,12,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Visibility="{Binding IsModVersionsLoading, Converter={StaticResource BoolToVis}}"/>
                                            <StackPanel Margin="0,12,0,0"
                                                        Visibility="{Binding HasModVersions, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Chọn phiên bản để cài" FontSize="12" Foreground="{StaticResource SunBrush}"/>
                                                <ComboBox Margin="0,4,0,0" Style="{StaticResource PillComboBox}"
                                                          ItemsSource="{Binding ModVersions}" DisplayMemberPath="Display"
                                                          SelectedItem="{Binding SelectedModVersion, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding ModDetail.Rows}" Margin="0,12,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="170"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Margin="0,14,0,0"
                                                        Visibility="{Binding ModDetail.HasChangelog, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Thông tin cập nhật" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource SunBrush}"/>
                                                <TextBlock Text="{Binding ModDetail.Changelog}" FontSize="12.5" Margin="0,6,0,0"
                                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Cài bản đã chọn" Style="{StaticResource PillButton}"
                                                Padding="22,9" FontSize="14" Foreground="{StaticResource SunBrush}"
                                                Command="{Binding InstallSelectedModVersionCommand}"
                                                Visibility="{Binding HasModVersions, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="{Binding ModDetailHit.ActionText}" Margin="10,0,0,0" Style="{StaticResource PillButton}"
                                                Padding="22,9" FontSize="14"
                                                Command="{Binding InstallModCommand}" CommandParameter="{Binding ModDetailHit}"/>
                                        <Button Content="Mở trang web" Margin="10,0,0,0" Style="{StaticResource PillButton}"
                                                Padding="22,9" FontSize="14"
                                                Command="{Binding OpenModPageCommand}" CommandParameter="{Binding ModDetail.PageUrl}"
                                                Visibility="{Binding ModDetail.HasPageUrl, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </ContentControl>
                        </Grid>
                    </Grid>

                    <!-- ========== Tài khoản ========== -->
                    <Grid x:Name="PageAccounts" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Microsoft / Xbox -->
                        <ContentControl Style="{StaticResource GlassCard}" VerticalAlignment="Top" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Microsoft / Xbox" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="ExtraBold" FontSize="22"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="Đăng nhập tài khoản Microsoft sở hữu Minecraft Java Edition bản quyền. Phiên được lưu để lần sau tự đăng nhập."/>

                                <StackPanel Visibility="{Binding IsMicrosoftSignedOut, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Đăng nhập Microsoft" Margin="0,18,0,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding MicrosoftSignInCommand}"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsMicrosoftSignedIn, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Đang đăng nhập với" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding MsAccountName}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource SunBrush}"/>
                                    <Button Content="Đăng xuất" Margin="0,16,0,0" HorizontalAlignment="Left"
                                            Style="{StaticResource PillButton}" Padding="22,9" FontSize="13"
                                            Command="{Binding MicrosoftSignOutCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>

                        <!-- Ely.by -->
                        <ContentControl Grid.Column="1" Style="{StaticResource GlassCard}" VerticalAlignment="Top"
                                        Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Ely.by" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="ExtraBold" FontSize="22"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="Đăng nhập tài khoản Ely.by (dùng skin Ely.by, không cần bản quyền Minecraft). Mật khẩu không được lưu."/>

                                <StackPanel Visibility="{Binding IsElySignedOut, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Tên đăng nhập hoặc email" Style="{StaticResource Label}"/>
                                    <TextBox Style="{StaticResource PillTextBox}"
                                             Text="{Binding ElyUser, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Mật khẩu" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="ElyPassBox" Style="{StaticResource PillPasswordBox}"/>
                                    <TextBlock Text="Mã 2FA (chỉ khi tài khoản bật xác thực 2 lớp)" Style="{StaticResource Label}"/>
                                    <TextBox Style="{StaticResource PillTextBox}" MaxLength="8"
                                             Text="{Binding ElyTotp, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Đăng nhập Ely.by" Margin="0,18,0,0"
                                            Style="{StaticResource PrimaryButton}" Click="ElyLogin_Click"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsElySignedIn, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Đang đăng nhập với" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding ElyAccountName}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource SunBrush}"/>
                                    <Button Content="Đăng xuất" Margin="0,16,0,0" HorizontalAlignment="Left"
                                            Style="{StaticResource PillButton}" Padding="22,9" FontSize="13"
                                            Command="{Binding ElyLogoutCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="6,16,0,0" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource SunBrush}" Text="{Binding AuthMessage}"/>
                    </Grid>

                    <!-- ========== Nhật ký ========== -->
                    <ContentControl x:Name="PageLog" Style="{StaticResource GlassCard}" Visibility="Collapsed" Padding="22,18">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Nhật ký" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="ExtraBold" FontSize="22" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Sao chép" Style="{StaticResource PillButton}" Padding="16,8" FontSize="13"
                                            Margin="0,0,8,0" Command="{Binding CopyLogCommand}"/>
                                    <Button Content="Xóa" Style="{StaticResource PillButton}" Padding="16,8" FontSize="13"
                                            Command="{Binding ClearLogCommand}"/>
                                </StackPanel>
                            </Grid>
                            <TextBox Style="{StaticResource LogBox}" Text="{Binding LogText, Mode=OneWay}"
                                     TextChanged="LogBox_TextChanged"/>
                        </DockPanel>
                    </ContentControl>

                    <!-- ========== Tin tức ========== -->
                    <ContentControl x:Name="PageNews" Style="{StaticResource GlassCard}" Visibility="Collapsed"
                                    VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Tin tức" FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold" FontSize="26"/>
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Sự kiện và thông báo của server sẽ hiển thị ở đây."/>
                        </StackPanel>
                    </ContentControl>

                    <!-- ========== Cài đặt chung ========== -->
                    <ContentControl x:Name="PageSettings" Style="{StaticResource GlassCard}" Visibility="Collapsed"
                                    Padding="22,18,12,18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0" MaxWidth="620" HorizontalAlignment="Left">
                                <TextBlock Text="Cài đặt chung" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="ExtraBold" FontSize="22"/>

                                <c:LiquidGlassCard Margin="0,16,0,4" Padding="18,14">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Giao diện" FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold"
                                                       FontSize="17" VerticalAlignment="Center"/>
                                            <c:LiquidGlassButton x:Name="GlassInfoButton" Content="?" HorizontalAlignment="Right"
                                                                 Padding="13,4" FontSize="13" Click="GlassInfo_Click"/>
                                            <c:LiquidGlassPopup x:Name="GlassInfoPopup" PlacementTarget="{Binding ElementName=GlassInfoButton}"
                                                                Placement="Bottom">
                                                <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="13"
                                                           Text="Liquid Glass BẬT: nền kính nhiều lớp, viền sáng phản chiếu, bóng, glow và ánh sáng chuyển động nhẹ. TẮT: giao diện Dark Flat phẳng, không hiệu ứng, nhẹ máy hơn. Bố cục và chức năng giữ nguyên."/>
                                            </c:LiquidGlassPopup>
                                        </Grid>
                                        <c:LiquidGlassToggle Margin="0,14,0,0" Content="Liquid Glass (kính, viền sáng, ánh sáng)"
                                                             IsChecked="{Binding LiquidGlassOn, Mode=TwoWay}"/>
                                        <c:LiquidGlassToggle Margin="0,12,0,0" Content="Giảm hiệu ứng chuyển động"
                                                             IsChecked="{Binding ReduceMotion, Mode=TwoWay}"/>
                                        <c:LiquidGlassToggle Margin="0,12,0,0" Content="Khúc xạ thật (bẻ cong ảnh nền ở viền kính)"
                                                             IsChecked="{Binding Refraction, Mode=TwoWay}" IsEnabled="{Binding RefractionAvailable}"/>
                                        <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                                   Text="Ảnh nền càng nhiều chi tiết thì khúc xạ càng rõ. Ảnh chỉ hiện ở chế độ Liquid Glass."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <c:LiquidGlassButton Content="Chọn ảnh nền" Padding="18,8" FontSize="13" Command="{Binding ChooseBackgroundCommand}"/>
                                            <c:LiquidGlassButton Content="Xóa ảnh nền" Margin="8,0,0,0" Padding="18,8" FontSize="13"
                                                                 Command="{Binding ClearBackgroundCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </c:LiquidGlassCard>

                                <c:LiquidGlassCard Margin="0,12,0,4" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock Text="Cá nhân hóa" FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold" FontSize="17"/>

                                        <TextBlock Text="Vị trí thanh menu" Style="{StaticResource Label}"/>
                                        <ComboBox Style="{StaticResource PillComboBox}" ItemsSource="{Binding MenuDockLabels}"
                                                  SelectedItem="{Binding MenuDockLabel, Mode=TwoWay}"/>

                                        <TextBlock Text="Màu sắc (gõ mã HEX, ví dụ #FFB703)" Style="{StaticResource Label}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Left"
                                                BorderThickness="1" BorderBrush="#66FFFFFF" Background="{Binding AccentSwatch}"/>
                                        <TextBlock Grid.Column="1" Text="Màu nhấn" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource PillTextBox}" MaxLength="7" Height="36" FontSize="13"
                                                 Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Left"
                                                BorderThickness="1" BorderBrush="#66FFFFFF" Background="{Binding BaseSwatch}"/>
                                        <TextBlock Grid.Column="1" Text="Màu nền" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource PillTextBox}" MaxLength="7" Height="36" FontSize="13"
                                                 Text="{Binding BaseHex, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Left"
                                                BorderThickness="1" BorderBrush="#66FFFFFF" Background="{Binding TextSwatch}"/>
                                        <TextBlock Grid.Column="1" Text="Màu chữ" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource PillTextBox}" MaxLength="7" Height="36" FontSize="13"
                                                 Text="{Binding TextHex, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Mặc định" Margin="0,6,6,0" Style="{StaticResource PillButton}" Padding="14,5" FontSize="12"
                                                Command="{Binding ApplyColorPresetCommand}" CommandParameter="Mặc định"/>
                                        <Button Content="Hồng" Margin="0,6,6,0" Style="{StaticResource PillButton}" Padding="14,5" FontSize="12"
                                                Command="{Binding ApplyColorPresetCommand}" CommandParameter="Hồng"/>
                                        <Button Content="Xanh biển" Margin="0,6,6,0" Style="{StaticResource PillButton}" Padding="14,5" FontSize="12"
                                                Command="{Binding ApplyColorPresetCommand}" CommandParameter="Xanh biển"/>
                                        <Button Content="Xanh lá" Margin="0,6,6,0" Style="{StaticResource PillButton}" Padding="14,5" FontSize="12"
                                                Command="{Binding ApplyColorPresetCommand}" CommandParameter="Xanh lá"/>
                                        <Button Content="Tím" Margin="0,6,6,0" Style="{StaticResource PillButton}" Padding="14,5" FontSize="12"
                                                Command="{Binding ApplyColorPresetCommand}" CommandParameter="Tím"/>
                                        <Button Content="Đỏ" Margin="0,6,6,0" Style="{StaticResource PillButton}" Padding="14,5" FontSize="12"
                                                Command="{Binding ApplyColorPresetCommand}" CommandParameter="Đỏ"/>
                                    </WrapPanel>
                                    <TextBlock Margin="2,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#FF9F43"
                                               Text="{Binding ContrastWarning}"
                                               Visibility="{Binding HasContrastWarning, Converter={StaticResource BoolToVis}}"/>

                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="Độ sáng kính (tăng nếu thấy nút và thẻ bị tối)" FontSize="13"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource SunBrush}"
                                                   Text="{Binding GlassBrightness, StringFormat='{}{0:P0}'}"/>
                                    </Grid>
                                    <c:LiquidGlassSlider Minimum="0" Maximum="1" Value="{Binding GlassBrightness, Mode=TwoWay}"/>
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="Độ đặc của thẻ (giảm để thấy rõ nền phía sau)" FontSize="13"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource SunBrush}"
                                                   Text="{Binding CardOpacity, StringFormat='{}{0:P0}'}"/>
                                    </Grid>
                                    <c:LiquidGlassSlider Minimum="0.15" Maximum="1" Value="{Binding CardOpacity, Mode=TwoWay}"/>
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="Độ đặc của thanh menu" FontSize="13"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource SunBrush}"
                                                   Text="{Binding MenuOpacity, StringFormat='{}{0:P0}'}"/>
                                    </Grid>
                                    <c:LiquidGlassSlider Minimum="0.15" Maximum="1" Value="{Binding MenuOpacity, Mode=TwoWay}"/>
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="Độ mạnh khúc xạ" FontSize="13"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource SunBrush}"
                                                   Text="{Binding RefractionStrength, StringFormat='{}{0:P0}'}"/>
                                    </Grid>
                                    <c:LiquidGlassSlider Minimum="0" Maximum="2" Value="{Binding RefractionStrength, Mode=TwoWay}"/>
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="Độ tối phủ lên ảnh nền" FontSize="13"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource SunBrush}"
                                                   Text="{Binding BackgroundDim, StringFormat='{}{0:P0}'}"/>
                                    </Grid>
                                    <c:LiquidGlassSlider Minimum="0" Maximum="0.9" Value="{Binding BackgroundDim, Mode=TwoWay}"/>

                                        <c:LiquidGlassToggle Margin="0,16,0,0" Content="Hiệu ứng tương tác (điểm sáng theo chuột, ánh sáng chạy, kéo dãn)"
                                                             IsChecked="{Binding FancyEffects, Mode=TwoWay}"/>
                                        <c:LiquidGlassButton Margin="0,14,0,0" HorizontalAlignment="Left" Content="Đặt lại cá nhân hóa"
                                                             Padding="18,8" FontSize="13" Command="{Binding ResetPersonalizationCommand}"/>
                                    </StackPanel>
                                </c:LiquidGlassCard>

                                <c:LiquidGlassCard Margin="0,12,0,4" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock Text="Tích hợp Windows" FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold" FontSize="17"/>
                                        <c:LiquidGlassToggle Margin="0,14,0,0" Content="Bấm đúp file .mrpack để mở launcher và nhập modpack"
                                                             IsChecked="{Binding MrpackAssociated, Mode=TwoWay}"/>
                                        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                                   Text="Nếu Windows vẫn mở file .mrpack bằng ứng dụng khác, hãy chọn KittyDy0 Launcher trong Cài đặt ứng dụng mặc định (nút bên dưới)."/>
                                        <c:LiquidGlassButton Margin="0,10,0,0" HorizontalAlignment="Left" Content="Mở cài đặt ứng dụng mặc định"
                                                             Padding="18,8" FontSize="13" Click="DefaultApps_Click"/>
                                    </StackPanel>
                                </c:LiquidGlassCard>

                                <TextBlock Text="Nguồn Java mặc định (instance chọn &quot;Theo cài đặt chung&quot; sẽ dùng)"
                                           Style="{StaticResource Label}"/>
                                <ComboBox Style="{StaticResource PillComboBox}" ItemsSource="{Binding GlobalJavaLabels}"
                                          SelectedItem="{Binding GlobalJavaLabel, Mode=TwoWay}"/>

                                <Grid Margin="0,14,0,6">
                                    <TextBlock Text="RAM mặc định cho instance mới" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="4,0,0,0"/>
                                    <TextBlock Text="{Binding DefaultRamGb, StringFormat='{}{0} GB'}" HorizontalAlignment="Right"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SunBrush}"/>
                                </Grid>
                                <c:LiquidGlassSlider Minimum="2" Maximum="16"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding DefaultRamGb, Mode=TwoWay}"/>

                                <CheckBox Style="{StaticResource GoldCheck}" Margin="4,18,0,0"
                                          Content="Thu nhỏ launcher khi game chạy, tự hiện lại khi thoát"
                                          IsChecked="{Binding HideOnPlay, Mode=TwoWay}"/>

                                <TextBlock Text="Tải sẵn Java (dùng nguồn Java mặc định ở trên, lỗi thì thử nguồn khác)"
                                           Style="{StaticResource Label}" Margin="4,22,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Style="{StaticResource PillComboBox}" Width="120"
                                              ItemsSource="{Binding JavaMajors}"
                                              SelectedItem="{Binding JavaInstallMajor, Mode=TwoWay}"/>
                                    <Button Content="Tải Java" Margin="10,0,0,0" Style="{StaticResource PillButton}"
                                            Padding="20,10" FontSize="14" Command="{Binding InstallJavaCommand}"/>
                                </StackPanel>
                                <TextBlock Margin="4,10,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding ManagedJavaText, StringFormat='Java đã tải: {0}'}"/>
                                <ProgressBar Margin="0,12,0,0" Style="{StaticResource GoldProgress}" Value="{Binding Progress}"/>
                                <TextBlock Margin="4,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding StatusText}" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Margin="0,22,0,4">
                                    <Button Content="Mở thư mục dữ liệu" Style="{StaticResource PillButton}"
                                            Padding="18,10" FontSize="13" Command="{Binding OpenDataFolderCommand}"/>
                                    <Button Content="Mở thư mục Java" Style="{StaticResource PillButton}" Margin="10,0,0,0"
                                            Padding="18,10" FontSize="13" Command="{Binding OpenJavaFolderCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</c:LiquidGlassWindow>
