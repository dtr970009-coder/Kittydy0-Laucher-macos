<!-- Skin LIQUID GLASS: kính nhiều lớp, viền sáng phản chiếu, bóng, glow. Cùng bộ key với Skin.Flat.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Các lớp hiệu ứng (inner highlight, gloss, sheen) chỉ hiện ở chế độ kính -->
    <Visibility x:Key="LgLayerVisibility">Visible</Visibility>

    <!-- Nền cửa sổ: gradient sâu thay vì màu đặc -->
    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C0E14" Offset="0"/>
        <GradientStop Color="#12090D" Offset="0.55"/>
        <GradientStop Color="#160B10" Offset="1"/>
    </LinearGradientBrush>

    <!-- Lớp 1: nền kính, gradient trắng ấm pha chút đỏ -->
    <LinearGradientBrush x:Key="LgFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3AFFFFFF" Offset="0"/>
        <GradientStop Color="#18FFE9C4" Offset="0.5"/>
        <GradientStop Color="#0EE63946" Offset="0.82"/>
        <GradientStop Color="#2AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LgFillHover" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="LgShadowCaster" Color="#3D000000"/>

    <!-- Lớp 2: viền phản chiếu, sáng ở góc trên trái, ngả đỏ/vàng ở giữa, mờ dần ở góc dưới phải -->
    <!-- Viền mảnh trắng sáng, sáng nhất ở góc trên-trái và dưới-phải như kính thật bắt sáng -->
    <LinearGradientBrush x:Key="LgEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#59FFE57F" Offset="0.3"/>
        <GradientStop Color="#33E63946" Offset="0.62"/>
        <GradientStop Color="#E6FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LgEdgeHot" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFE57F" Offset="0.35"/>
        <GradientStop Color="#FFE63946" Offset="0.75"/>
        <GradientStop Color="#99FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Lớp 3: viền sáng bên trong (inner highlight), phản chiếu phần mép trên -->

    <!-- Tán sắc: dải màu cầu vồng sát mép (ánh sáng bị khúc xạ), hai lớp chạy ngược chiều nhau -->
    <!-- Ánh sáng nhòe bên trong sát mép -->
    <!-- Viền núm thanh trượt -->
    <LinearGradientBrush x:Key="LgThumbRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.5"/>
        <GradientStop Color="#EEFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Lớp 4: gloss nửa trên và bóng nhẹ nửa dưới -->
    <LinearGradientBrush x:Key="LgGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3CFFFFFF" Offset="0"/>
        <GradientStop Color="#0CFFFFFF" Offset="0.35"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LgInnerShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.55"/>
        <GradientStop Color="#2E000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Bóng nhiều lớp: bóng đổ mềm + glow đỏ khi hover + glow vàng cho nút chính -->
    <DropShadowEffect x:Key="LgShadow" Color="#000000" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.55"/>
    <DropShadowEffect x:Key="LgGlow" Color="#E63946" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
    <DropShadowEffect x:Key="LgPrimaryGlow" Color="#FFB703" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="LgThumbShadow" Color="#000000" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.5"/>

    <!-- Nút chính (vàng) -->
    <LinearGradientBrush x:Key="LgPrimaryFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFF2B8" Offset="0"/>
        <GradientStop Color="#FFFFE57F" Offset="0.3"/>
        <GradientStop Color="#FFFFB703" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LgPrimaryEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CCFFFFFF" Offset="0"/>
        <GradientStop Color="#66FFE57F" Offset="1"/>
    </LinearGradientBrush>

    <!-- Giọt kính của menu: vàng trong, vẫn để lộ khúc xạ phía sau -->
    <LinearGradientBrush x:Key="LgBubbleTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#99FFF2B8" Offset="0"/>
        <GradientStop Color="#85FFD54A" Offset="0.5"/>
        <GradientStop Color="#99FFB703" Offset="1"/>
    </LinearGradientBrush>

    <!-- Ô nhập, popup, núm thanh trượt -->
    <SolidColorBrush x:Key="LgInputFill" Color="#59000000"/>
    <SolidColorBrush x:Key="LgInputEdge" Color="#59FFE57F"/>
    <SolidColorBrush x:Key="LgPopupFill" Color="#F21F121C"/>
    <SolidColorBrush x:Key="LgPopupEdge" Color="#8CFFD27D"/>
    <RadialGradientBrush x:Key="LgThumbFill" GradientOrigin="0.3,0.25" Center="0.4,0.4" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFE57F" Offset="0.55"/>
        <GradientStop Color="#FFFFB703" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
